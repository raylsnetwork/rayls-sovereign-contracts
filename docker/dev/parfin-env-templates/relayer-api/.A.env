# Baseline env for the 3.0.x CTS (kos) + public-relayer, participant A.
# Consumed via `--env /parfin/rayls-privacy-relayer-api/.A.env`. The contracts
# deploy appends/overwrites the deploy-specific values (deployment proxy
# registries, starting blocks) after deployment — infra values live here.
# Cert paths point at the compose-level rayls-certs volume (/certs), generated
# by the certs-init service.
#
# NOTE: no PNH_DEPLOYMENT_PROXY_REGISTRY here on purpose — the deploy writes it
# in hub mode, and its ABSENCE is what switches the 3.0.1 CTS into hub-less
# mode (HUB_ENABLED=false deploys never write any PNH_* value).

# ── shared ──────────────────────────────────────────────────────────────
NATS_URL=tls://nats:4222
NATS_TLS_CA_FILE=/certs/ca.crt
NATS_TLS_CERT_FILE=/certs/cts.crt
NATS_TLS_KEY_FILE=/certs/cts.key
PNH_RPC_URL=http://private-hub:3445
PRIVACY_NODE_RPC_URL=http://pn-a:8545
PUBLIC_CHAIN_RPC_URL=https://testnet-rpc.rayls.com/
PRIVACY_NODE_CHAIN_ID=12345
LOG_LEVEL=INFO
LOG_HANDLER=Text

# ── CTS (Cryptography Trust Suite, runs in the kos-a service) ───────────
CTS_DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/ctsA?sslmode=disable
CTS_CORSDOMAIN=*
CTS_API_KEY=*
CTS_SECRET=dev-only-not-a-secret
CTS_ENCRYPTORSERVICE=plaintext
BLOCKCHAIN_CHAIN_ID=12345
PNH_OPERATOR_CHAIN_ID=999
# gRPC server mTLS (server cert has SANs cts, cts-a..f, localhost)
CTS_TLS_CA_FILE=/certs/ca.crt
CTS_TLS_CERT_FILE=/certs/server.crt
CTS_TLS_KEY_FILE=/certs/server.key

# ── public-relayer ──────────────────────────────────────────────────────
RAYLS_NODE_DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/publicRelayerA?sslmode=disable
CTS_GRPC_URL=cts-a:8080
CTS_CLIENT_TLS_CA_FILE=/certs/ca.crt
CTS_CLIENT_TLS_CERT_FILE=/certs/public-relayer.crt
CTS_CLIENT_TLS_KEY_FILE=/certs/public-relayer.key

# ── private relayer (hub/full mode only; inert in hub-less stacks) ───────
PRIVATE_RELAYER_DATABASE_CONNECTIONSTRING=postgres://admin:admin@postgres:5432/relayerA?sslmode=disable
PRIVACY_NODE_ENYGMA_PROOF_API_ADDRESS=http://proofs-api:3003
NUMBER_OF_JS_PARAMS_IN=10
