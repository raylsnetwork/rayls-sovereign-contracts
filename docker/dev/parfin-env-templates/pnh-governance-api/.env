# Baseline env for the PNH governance services (api/listener/flagger),
# consumed via `--config /parfin/rayls-privacy-pnh-governance-api/.env`. The
# contracts deploy appends the PNH_* configuration (registry, keys, chain ids)
# after the hub deploy — infra values live here. Cert paths point at the
# compose-level rayls-certs volume (/certs), generated by certs-init.
DATABASE_CONNECTIONSTRING=postgres://governance:dev-only-not-a-secret@postgres:5432/governance?sslmode=disable
LOGGING=development
CORSURLS=http://localhost;http://governance-api
NATS_URL=tls://nats:4222
NATS_TLS_CA_FILE=/certs/ca.crt
NATS_TLS_CERT_FILE=/certs/governance.crt
NATS_TLS_KEY_FILE=/certs/governance.key
