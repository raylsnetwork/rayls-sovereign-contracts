{
  "name": "@rayls/contracts",
  "version": "2.6.3-nightly.2",
  "license": "Apache-2.0",
  "files": [
    "src/rayls-protocol-sdk/**/*.sol",
    "src/rayls-node/rayls-privacy-ledger/RNMessageLib.sol",
    "src/rayls-node/rayls-privacy-ledger/RelayAuthorizationRegistry.sol",
    "src/rayls-node/rayls-privacy-ledger/interfaces/*.sol"
  ],
  "scripts": {
    "patch-gobind": "sed -i.bak -e 's|.toLowerCase()||g' -e 's|`${genDir}|`${this.outDir}|g' -e 's|await fsp.mkdir(g|//await fsp.mkdir(g|g' -e 's|this.go = new Go();|this.go = new Go(); this.go.argv = []; this.go.env = {};|g' node_modules/@solarity/hardhat-gobind/dist/src/abigen/generator.js",
    "compile": "hardhat compile",
    "compile:subset": "node scripts/compile-contracts.js --parallel",
    "bindings:delete": "bash scripts/delete-bindings.sh",
    "bindings:generate:relayer": "node scripts/generate-bindings.js relayer",
    "bindings:generate:governance": "node scripts/generate-bindings.js governance",
    "bindings:generate:ops-service": "node scripts/generate-bindings.js ops-service",
    "bindings:move": "bash scripts/move-bindings.sh",
    "deploy:private-hub": "hardhat deploy:private-hub",
    "deploy:privacy-node": "hardhat deploy:privacy-node",
    "test:unit": "hardhat test ./hardhat/test/unit/*.ts",
    "test:unit-enygma": "hardhat test ./hardhat/test/unit/Enygma.ts",
    "test:unit-erc20": "hardhat test ./hardhat/test/unit/TokenExample.ts",
    "test:unit-custom": "hardhat test ./hardhat/test/unit/TokenCustomExample.ts",
    "test:forge": "forge test -vv",
    "test:forge:security": "forge test --match-path 'src/test/*.t.sol' -vv",
    "test:forge:gas": "forge test -vv --gas-report",
    "test:sizes": "forge build --sizes",
    "audit:deploy": "hardhat audit:deploy-selectors",
    "audit:all": "hardhat audit:all",
    "audit:pnh:strict": "hardhat audit:deploy-selectors --strict-unchecked && hardhat audit:pnh",
    "audit:pn:strict": "hardhat audit:deploy-selectors --strict-unchecked && hardhat audit:pn",
    "audit:pc:strict": "hardhat audit:deploy-selectors --strict-unchecked && hardhat audit:pc"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.1.0",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.1.2",
    "@nomicfoundation/hardhat-toolbox": "^6.1.2",
    "@openzeppelin/contracts": "5.4.0",
    "@solarity/hardhat-gobind": "^1.3.0",
    "@typechain/ethers-v6": "^0.5.1",
    "@typechain/hardhat": "^9.1.0",
    "@types/chai": "^4.3.20",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.15.0",
    "ajv": "^8.17.1",
    "hardhat": "^2.28.4",
    "hardhat-artifactor": "^0.2.0",
    "hardhat-contract-sizer": "^2.10.1",
    "mocha": "^11.7.5",
    "nano-time": "^1.0.0",
    "poseidon-solidity": "^0.0.5",
    "prettier": "^3.8.1",
    "prettier-plugin-solidity": "^2.2.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "dependencies": {
    "@ethersproject/bignumber": "^5.8.0",
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/wallet": "^5.8.0",
    "@nomicfoundation/hardhat-ethers": "^3.1.3",
    "@openzeppelin/contracts-upgradeable": "5.4.0",
    "@swc-node/register": "^1.11.1",
    "axios": "^1.13.4",
    "chai": "^4.5.0",
    "dotenv": "^16.6.1",
    "ethers": "^6.16.0",
    "typescript": "^5.9.3"
  }
}
